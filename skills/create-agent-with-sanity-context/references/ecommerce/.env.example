# Ecommerce Demo Configuration
# Copy this file to .env and fill in your values

# Sanity project
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# SANITY_STUDIO_API_HOST=  # Optional, defaults to https://api.sanity.io

# Next.js app (derived from above, NEXT_PUBLIC_ prefix exposes to browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=${SANITY_STUDIO_PROJECT_ID}
NEXT_PUBLIC_SANITY_DATASET=${SANITY_STUDIO_DATASET}
# NEXT_PUBLIC_SANITY_API_HOST=${SANITY_STUDIO_API_HOST}

# Chat assistant
# Organization API token with Context Editor permissions, created in Manage under
# your organization's API > Tokens. Reads the MCP endpoint and writes conversation
# transcripts to the organization's Context store. Project tokens don't work.
SANITY_ORGANIZATION_TOKEN=

# MCP endpoint URL, shown on the endpoint in the Context app in the Sanity Dashboard
# https://api.sanity.io/v1/context/organizations/<organizationId>/mcp/<endpointName>
SANITY_CONTEXT_MCP_URL=

# Conversation insights: the Sanity organization ID and the MCP endpoint's name
# (the last path segment of SANITY_CONTEXT_MCP_URL)
# Also used by the scheduled classification function (functions/classify-conversations)
SANITY_ORGANIZATION_ID=
SANITY_CONTEXT_ENDPOINT_NAME=

# Anthropic API key for the Claude AI chat assistant and the classification function
ANTHROPIC_API_KEY=

# Anthropic model to use (optional, defaults to claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Agent config slug (matches agent.config document in Studio)
AGENT_CONFIG_SLUG=default
