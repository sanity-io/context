# Sanity Context MCP endpoint. Copy the URL from the endpoint's page in the
# Context app in the Sanity Dashboard. It looks like:
# https://api.sanity.io/v2026-11-03/context/organizations/<organizationId>/mcp/<endpointName>
SANITY_CONTEXT_MCP_URL=

# Organization API token with the Context permission (Viewer). Create it in
# Manage under your organization's API > Tokens. Project tokens don't work.
SANITY_ORGANIZATION_TOKEN=

# Model access. Jev and both writing models run through the Vercel AI Gateway.
# Set an AI Gateway key for local runs, or run `eve link` to use your project's
# VERCEL_OIDC_TOKEN instead. Deployed projects authenticate automatically.
AI_GATEWAY_API_KEY=
