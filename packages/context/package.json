{
  "name": "@sanity/context",
  "version": "3.0.1",
  "description": "Tools for building AI agents with structured access to Sanity content",
  "keywords": [
    "sanity",
    "ai",
    "agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/context.git",
    "directory": "packages/context"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./insights": {
      "source": "./src/insights/index.ts",
      "import": "./dist/insights.js",
      "default": "./dist/insights.js"
    },
    "./ai-sdk": {
      "source": "./src/integrations/ai-sdk/index.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./langchain": {
      "source": "./src/integrations/langchain/index.ts",
      "import": "./dist/langchain.js",
      "default": "./dist/langchain.js"
    },
    "./mastra": {
      "source": "./src/integrations/mastra/index.ts",
      "import": "./dist/mastra.js",
      "default": "./dist/mastra.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pkg build --strict --clean --check",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit",
    "dev": "pkg-utils watch",
    "test": "vitest run --typecheck",
    "test:unit": "vitest --typecheck",
    "test:unit:coverage": "vitest run --coverage"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "devDependencies": {
    "@langchain/core": "^1.4.0",
    "@langchain/mcp-adapters": "^2.0.3",
    "@mastra/mcp": "^2.9.0",
    "@repo/eslint-config": "workspace:*",
    "@sanity/client": "catalog:",
    "@sanity/pkg-utils": "^10.4.13",
    "@sanity/tsconfig": "^2.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ai": "catalog:",
    "ai-v7": "npm:ai@^7",
    "langchain": "^1.6.5",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@langchain/core": "^1.4.0",
    "@langchain/mcp-adapters": "^2",
    "@mastra/mcp": "^2",
    "@sanity/client": "^8.15.0",
    "ai": "^6.0.175 || ^7",
    "langchain": "^1.6.0",
    "zod": "^3.20 || ^4"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/mcp-adapters": {
      "optional": true
    },
    "@mastra/mcp": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
