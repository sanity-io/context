{
  "name": "@sanity/context",
  "version": "3.0.1",
  "description": "Tools for building AI agents with structured access to Sanity content",
  "keywords": [
    "sanity",
    "ai",
    "agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/context.git",
    "directory": "packages/context"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./insights": {
      "source": "./src/insights/index.ts",
      "import": "./dist/insights.js",
      "default": "./dist/insights.js"
    },
    "./ai-sdk": {
      "source": "./src/integrations/ai-sdk/index.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pkg build --strict --clean --check",
    "check:lint": "eslint .",
    "check:lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit",
    "dev": "pkg-utils watch",
    "test": "vitest run --typecheck",
    "test:unit": "vitest --typecheck",
    "test:unit:coverage": "vitest run --coverage"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@sanity/client": "catalog:",
    "@sanity/pkg-utils": "^10.4.13",
    "@sanity/tsconfig": "^2.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ai": "catalog:",
    "ai-v7": "npm:ai@^7",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@sanity/client": "^8.15.0",
    "ai": "^6.0.175 || ^7",
    "zod": "^3.20 || ^4"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
