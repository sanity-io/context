# Only needed for --live: a Context MCP endpoint and an organization API token with Context access.
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-11-03/context/organizations/<organizationId>/mcp/<endpointName>
SANITY_CONTEXT_TOKEN=
# Optional with --live: what the endpoint covers, for eve's connection description.
SANITY_CONTEXT_DESCRIPTION=

# Only needed for --model and --chat.
ANTHROPIC_API_KEY=
