{
  "name": "@sanity/context-eve",
  "version": "0.0.0",
  "private": true,
  "description": "Sanity Context for eve agents",
  "keywords": [
    "sanity",
    "sanity-context",
    "eve",
    "eve-extension",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/context.git",
    "directory": "packages/eve"
